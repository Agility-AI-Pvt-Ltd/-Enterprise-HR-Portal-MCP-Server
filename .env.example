# Neon PostgreSQL connection string (Neon console → Connection Details)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Shared password for the remote server. Anyone who knows it can connect.
# Claude Desktop shows a login page; other clients can send "Authorization: Bearer <password>".
# Changing it disconnects every client.
SERVER_PASSWORD=change-me-to-a-strong-password

# stdio (local Claude Desktop config, no password needed) or http (Render / remote)
MCP_TRANSPORT=stdio
# PORT=8000
# PUBLIC_URL=https://your-app.onrender.com   # auto-detected on Render
